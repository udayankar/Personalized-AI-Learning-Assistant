# Development example. Do not use this file as production configuration.
APP_ENV=development

LLM_API_KEY=REPLACE_WITH_YOUR_PROVIDER_KEY
DATABASE_URL=postgresql://username:password@localhost:5432/Learning-Assistant
ANSWER_CACHE_TTL_SECONDS=86400

# Generate independent random values for JWT and CSRF, for example with Python secrets.token_urlsafe(32).
# Never reuse one value for both keys. Replace both placeholders before starting the app.
SECRET_KEY=REPLACE_WITH_A_RANDOM_JWT_SECRET_OF_AT_LEAST_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CSRF_SECRET_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_CSRF_SECRET_OF_AT_LEAST_32_BYTES
CSRF_TOKEN_TTL_SECONDS=3600

# Local development may use HTTP. Production requires COOKIE_SECURE=true and explicit HTTPS origins.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:1234

# Per-upload and per-account PDF limits. Files are streamed to per-user staging files.
MAX_PDF_UPLOAD_SIZE_BYTES=20971520
MAX_PDF_PAGE_COUNT=250
MAX_USER_PDF_STORAGE_BYTES=209715200

# For production, set APP_ENV=production, COOKIE_SECURE=true, and
# CORS_ALLOWED_ORIGINS to comma-separated HTTPS frontend origins.

